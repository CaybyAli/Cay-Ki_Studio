@echo off
setlocal
chcp 65001 >nul
title Cay Studio starten
set "CAY_START_HELPER=%~dp0Cay_Studio_Startcheck.py"
echo Cay Studio Starthilfe 1.1 - Pfadkorrektur
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $helper=$env:CAY_START_HELPER; if (-not (Test-Path -LiteralPath $helper)) { Write-Host 'Cay_Studio_Startcheck.py fehlt. Bitte das komplette ZIP entpacken.'; exit 1 }; $distros=@(& wsl.exe --list --quiet 2>$null); if ($LASTEXITCODE -ne 0) { Write-Host 'WSL konnte nicht abgefragt werden. Bitte Ubuntu im Startmenue oeffnen.'; exit 1 }; $chosen=$null; foreach ($entry in $distros) { $d=([string]$entry).Replace([string][char]0,'').Trim(); if (-not $d -or $d -like 'docker-desktop*') { continue }; try { & wsl.exe -d $d -u alihu --exec test -f /home/alihu/ki-video/studio/config/ablage.json 2>$null } catch { continue }; if ($LASTEXITCODE -eq 0) { $chosen=$d; break } }; if (-not $chosen) { Write-Host 'Cay Studio wurde in den vorhandenen WSL-Distributionen fuer Benutzer alihu nicht gefunden. Bitte Ausgabe von wsl -l -v schicken.'; exit 1 }; Write-Host ('WSL: '+$chosen); $windowsPath=$helper.Replace([char]92,[char]47); $linuxPath=(& wsl.exe -d $chosen -u alihu --exec wslpath -u $windowsPath); if ($LASTEXITCODE -ne 0) { throw 'Startdateipfad konnte nicht umgewandelt werden.' }; $linuxPath=([string]$linuxPath).Trim(); if (-not $linuxPath.StartsWith('/')) { throw 'WSL lieferte keinen absoluten Linux-Pfad.' }; $log=Join-Path (Split-Path -LiteralPath $helper) 'Cay_Studio_Startprotokoll.txt'; $ErrorActionPreference='Continue'; & wsl.exe -d $chosen -u alihu --exec /usr/bin/python3 $linuxPath 2>&1 | Tee-Object -FilePath $log; $code=$LASTEXITCODE; $ErrorActionPreference='Stop'; $opened=$false; foreach ($url in @('http://127.0.0.1:8787','http://localhost:8787')) { try { $health=Invoke-RestMethod -Uri ($url+'/api/health') -TimeoutSec 5; if ($health.app -eq 'CayStudio') { Start-Process $url; Write-Host ('Geoeffnet: '+$url+' | Version '+$health.version); $opened=$true; break } } catch {} }; if (-not $opened) { Write-Host 'Windows erreicht das Dashboard noch nicht. Falls oben DASHBOARD ANTWORTET steht, liegt das Problem zwischen Windows und WSL. Siehe Startanleitung. Keine Dienste wurden beendet.' }; Write-Host ('Startprotokoll: '+$log); exit $code"
echo.
echo Dieses Fenster darf nach dem Start geschlossen werden.
pause
